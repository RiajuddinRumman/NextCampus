# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_BASE_URL=http://localhost:3000
# Where the web application lives. Verification and reset links are mailed to
# this origin, because a link has to arrive somewhere a browser can read: the
# API routes that consume those tokens are POST-only and answer 404 to the click.
# Leave it empty and the links keep pointing at APP_BASE_URL's routes, which is
# only useful while there is no front end to point at.
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres@localhost:5432/scsp_dev?schema=public

# Sessions
# Signs the httpOnly `scsp.session` cookie. At least 32 characters, and it is a
# secret: generate one with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Whoever holds it can mint a session for any account, and changing it signs
# everybody out (the cookie then fails verification and the person signs in again).
JWT_SECRET=change-me-to-a-32-byte-hex-string

# Which students may have an account is not set here. The address rule is the
# constant in src/config/env.ts, so widening it is a commit and a review,
# not an environment change.

# Email delivery (optional outside production; verification links are logged
# instead when unset, which is what the local development flow and the test
# suite read from). Under NODE_ENV=production it is REQUIRED: a live login or
# reset link in a log file is a credential to whoever can read the log, so the
# process refuses to boot with an empty host rather than falling back to logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Student Platform <no-reply@example.com>"

# Cloudinary media storage (optional in development; uploads answer 503 when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=student-platform
# The exact prefix a stored image link must start with. Leave it empty to derive
# it from the cloud name above; set it only when a CDN serves the images from
# another host. This is not a cosmetic detail: a listing and a profile picture
# store a URL, and the front end loads whatever URL it is given, so the rule is
# "it came out of our own upload route" and nothing looser than that.
CLOUDINARY_BASE_URL=

# CORS (comma separated browser origins; defaults to the local Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (NestJS Throttler baseline)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# How many proxies forward requests to this process. Set it to the number of
# hops you actually own (1 for a single nginx in front, 2 for a CDN behind a
# load balancer) or the per-IP limits and the session's recorded address will
# count the proxy instead of the student. Leave 0 when nothing is in front:
# X-Forwarded-For is then ignored rather than trusted.
TRUST_PROXY_HOPS=0
